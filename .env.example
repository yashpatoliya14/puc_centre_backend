# ==============================================================================
# PucFlow — Environment Configuration
# Copy this file to .env and populate secrets for production deployment.
# ==============================================================================

# Public application URL (used for webhooks, password resets, and verification links)
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# ------------------------------------------------------------------------------
# External Supabase PostgreSQL Database (via Prisma & pg Pool)
# Leave empty during local preview to use the automatic embedded SQLite fallback.
# ------------------------------------------------------------------------------
DATABASE_URL=""
DIRECT_URL=""

# ------------------------------------------------------------------------------
# Security & Encryption Secrets (Server-side only — never expose to browser)
# CREDENTIALS_ENCRYPTION_KEY must be a 64-character hex string (32 bytes for AES-256-GCM)
# ------------------------------------------------------------------------------
SESSION_SIGNING_SECRET=""
CREDENTIALS_ENCRYPTION_KEY=""
SESSION_TTL_DAYS="30"

# ------------------------------------------------------------------------------
# Background Job Queue (BullMQ + Redis)
# Leave empty to use the built-in persistent in-process scheduler & worker.
# ------------------------------------------------------------------------------
REDIS_URL=""

# ------------------------------------------------------------------------------
# Telephony Provider — Exotel (Optional global defaults; tenants can override in Settings)
# ------------------------------------------------------------------------------
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.in.exotel.com"
EXOTEL_CALLER_ID=""
EXOTEL_APP_URL=""
EXOTEL_WEBHOOK_SECRET=""

# Default timezone for PUC expiry & calling windows
DEFAULT_TIMEZONE="Asia/Kolkata"

# Meta WhatsApp Cloud API Templates
WHATSAPP_TEMPLATE_NAME="puc_certificate_utility"
WHATSAPP_INSURANCE_TEMPLATE_NAME="vehicle_insurance"
WHATSAPP_TEMPLATE_LANGUAGE="en"
